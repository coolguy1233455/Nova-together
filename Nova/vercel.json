{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip npm ci",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/image.js": { "maxDuration": 120 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(sw|uv-sw).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(pe|scripts|reelleague)/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/scripts/v2/sdk.js", "destination": "/scripts/sdk.js" },
    { "source": "/pe/scripts/v2/sdk.js", "destination": "/scripts/sdk.js" },
    { "source": "/pe/scripts/:file(sdk\\.js|save-sync\\.js|save-migrate\\.js|crazy/sdk\\.js)", "destination": "/scripts/:file" },
    { "source": "/scripts/:path*", "destination": "https://games.pizzaedition.com/scripts/:path*" },
    { "source": "/pe/:path*", "destination": "https://games.pizzaedition.com/:path*" },
    { "source": "/reelleague/:path*", "destination": "https://games.pizzaedition.com/reelleague/:path*" }
  ]
}
